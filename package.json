{
  "name": "knowledge-net",
  "private": true,
  "type": "module",
  "description": "知識ネットワーク：教材が書き出す概念・関係・導出（kn-schema）を読んで表示する",
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "test": "npm run gen && vitest run",
    "e2e": "playwright test",
    "check": "npm run design && npm run test && npm run build && npm run e2e",
    "design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "1.2.1",
    "ajv": "8.20.0",
    "cytoscape": "3.34.4",
    "cytoscape-dagre": "2.5.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.8.1"
  }
}
