 "concepts": [
  {
   "id": "stats2:TERM-var",
   "name": "分散",
   "status": "filled",
   "version": 1,
   "units": [
    "stats2:U07",
    "stats2:U13",
    "stats2:U14",
    "stats2:U18"
   ],
   "problems": [],
   "en": "variance",
   "definition": "確率変数が期待値からどれだけ散らばるかを、ずれの2乗の期待値で表した量。",
   "principle": "(X−μ)² の期待値。2乗するので向きが消え、大きなずれほど重く効く。単位は元の単位の2乗になる。",
   "formulas": [
    {
     "tex": "V(X)=E\\big[(X-\\mu)^2\\big]=E(X^2)-\\{E(X)\\}^2",
     "symbols": [
      {
       "symbol": "V(X)",
       "meaning": "X の分散",
       "range": "0以上"
      },
      {
       "symbol": "μ",
       "meaning": "X の期待値 E(X)"
      },
      {
       "symbol": "(X−μ)²",
       "meaning": "期待値からのずれの2乗"
      }
     ]
    },
    {
     "tex": "V(aX+b)=a^2V(X)",
     "label": "1次式の分散",
     "symbols": [
      {
       "symbol": "a",
       "meaning": "掛ける定数（2乗で効く）"
      },
      {
       "symbol": "b",
       "meaning": "足す定数（散らばりは変えない）"
      }
     ]
    }
   ],
   "conditions": {
    "math": [
     "期待値と、2乗の期待値が有限"
    ],
    "data": [
     "外れ値が1つあると大きく変わる（2乗で効く）ので、分布の形も一緒に見る"
    ]
   },
   "example": "さいころの目の分散は 91÷6−3.5²＝35/12≒2.92。",
   "counterexample": "X＋Y の分散は、独立（または共分散が0）でなければ V(X)＋V(Y) にならない。",
   "misconceptions": [
    {
     "misconception": "分散は「平均からのずれの平均」",
     "correction": "ずれをそのまま平均すると0になる。2乗してから平均する"
    },
    {
     "misconception": "分散と標準偏差は同じ単位",
     "correction": "分散は元の単位の2乗。元の単位で言うなら平方根の標準偏差"
    }
   ],
   "sources": [
    {
     "title": "公式2級範囲表",
     "locator": "確率モデルの導入（確率変数・確率分布）",
     "url": "https://www.toukei-kentei.jp/hubfs/files/grade_range/grade2_hani_20181214.pdf"
    }
   ]
  },
  {
   "id": "stats2:TERM-std",
   "name": "標準化",
   "status": "filled",
   "version": 1,
   "units": [
    "stats2:U08",
    "stats2:U16"
   ],
   "problems": [],
   "en": "standardization",
   "definition": "値から平均を引き、標準偏差で割って、平均0・標準偏差1 の尺度に直すこと。",
   "principle": "1次の変換なので分布の形は変わらない。単位や大きさの違う値を「平均から標準偏差いくつ分か」で比べられる。正規分布なら標準正規分布 N(0, 1) になり、1つの表で確率が読める。",
   "formulas": [
    {
     "tex": "Z=\\dfrac{X-\\mu}{\\sigma}",
     "symbols": [
      {
       "symbol": "Z",
       "meaning": "標準化した値（平均から標準偏差いくつ分か）",
       "key": "Z",
       "kind": "rv"
      },
      {
       "symbol": "X",
       "meaning": "元の値",
       "key": "X",
       "kind": "rv"
      },
      {
       "symbol": "μ",
       "meaning": "平均",
       "key": "mu",
       "kind": "param",
       "concept": "stats2:TERM-expect"
      },
      {
       "symbol": "σ",
       "meaning": "標準偏差",
       "range": "0より大きい",
       "key": "sigma",
       "kind": "param",
       "concept": "stats2:TERM-var"
      }
     ],
     "tree": {
      "op": "eq",
      "args": [
       {
        "sym": "Z"
       },
       {
        "op": "div",
        "args": [
         {
          "op": "sub",
          "args": [
           {
            "sym": "X"
           },
           {
            "sym": "mu"
           }
          ]
         },
         {
          "sym": "sigma"
         }
        ]
       }
      ]
     }
    },
    {
     "tex": "E(Z)=0,\\quad V(Z)=1"
    }
   ],
   "conditions": {
    "math": [
     "標準偏差が0でない"
    ],
    "data": [
     "平均と標準偏差を、比べたい集団から出しているか（別の集団の値で割らない）"
    ]
   },
   "example": "平均60点・標準偏差10点のテストで、80点は z＝2。",
   "counterexample": "標準化しても分布の形は変わらない。右に裾の長いデータを標準化しても、正規分布にはならない。",
   "misconceptions": [
    {
     "misconception": "標準化すると正規分布になる",
     "correction": "位置と広がりをそろえるだけで、形は元のまま"
    }
   ],
   "sources": [
    {
     "title": "公式2級範囲表",
     "locator": "確率モデルの導入（確率変数・確率分布）",
     "url": "https://www.toukei-kentei.jp/hubfs/files/grade_range/grade2_hani_20181214.pdf"
    }
   ],
   "labs": [
    {
     "id": "LAB-z",
     "preset": "s1-z",
     "purpose": "値を平均から標準偏差いくつ分かに直す",
     "title": "標準化",
     "url": "https://watanabe-masao.github.io/stats2-labs/zscore/?p=s1-z",
     "kind": "check"
    }
   ]
  },
  {
   "id": "stats2:TERM-normal",
   "name": "正規分布",
   "status": "filled",
   "version": 1,
   "units": [
    "stats2:U08",
    "stats2:U16",
    "stats2:U19"
   ],
   "problems": [],
   "en": "normal distribution",
   "definition": "確率密度が f(x) の式で表される連続分布 N(μ, σ²)。平均 μ を中心に左右対称な釣鐘の形になる。",
   "principle": "小さな独立の要因がたくさん足し合わさると、この形に近づく（中心極限定理）。μ と σ の2つで形が決まり、μ±σ に約68%、μ±2σ に約95% が入る。",
   "formulas": [
    {
     "tex": "f(x)=\\dfrac{1}{\\sqrt{2\\pi}\\,\\sigma}\\exp\\!\\Big(-\\dfrac{(x-\\mu)^2}{2\\sigma^2}\\Big)",
     "symbols": [
      {
       "symbol": "μ",
       "meaning": "平均（山の中心）"
      },
      {
       "symbol": "σ",
       "meaning": "標準偏差（山の広がり）",
       "range": "0より大きい"
      },
      {
       "symbol": "f(x)",
       "meaning": "確率密度（高さ。面積が確率）"
      }
     ]
    }
   ],
   "conditions": {
    "math": [
     "確率密度が f(x) の式で表される（μ と σ で決まる）"
    ],
    "data": [
     "ヒストグラムが左右対称で山が1つなのは手掛かりにすぎず、それだけでは正規分布と言えない（裾の重さなども見る）",
     "正規分布を前提にする方法は、ずれがあると結論が揺れる"
    ]
   },
   "example": "二項分布 B(100, 0.5) は、平均50・標準偏差5 の正規分布で近似できる。",
   "counterexample": "売上や所得のように右に裾が長いデータでは、平均±2σ に95%が入るとは限らない。",
   "misconceptions": [
    {
     "misconception": "左右対称で山が1つなら正規分布",
     "correction": "左右対称な山1つの分布はほかにもある（裾の重い分布など）。形の手掛かりと、正規分布であることは別",
     "labs": [
      {
       "id": "LAB-cont",
       "preset": "s3-free",
       "purpose": "名前を隠した分布の裾を比べる",
       "title": "連続分布ラボ",
       "url": "https://watanabe-masao.github.io/stats2-labs/continuous/?p=s3-free"
      }
     ]
    },
    {
     "misconception": "データはふつう正規分布になる",
     "correction": "正規分布に近づくのは、独立な要因が足し合わさるときなど。売上・所得など右に裾の長いデータは多い"
    }
   ],
   "sources": [
    {
     "title": "公式2級範囲表",
     "locator": "確率モデルの導入（確率変数・確率分布）",
     "url": "https://www.toukei-kentei.jp/hubfs/files/grade_range/grade2_hani_20181214.pdf"
    }
   ]
  },
  {
   "id": "stats2:TERM-expect",
   "name": "期待値",
   "status": "filled",
   "version": 1,
   "units": [
    "stats2:U06",
    "stats2:U13",
    "stats2:U14",
    "stats2:U15"
   ],
   "problems": [],
   "en": "expected value",
   "definition": "確率変数がとる値を、その確率で重み付けした平均。",
   "principle": "値×確率の和。同じ試行を何度もくり返したときの平均の行き着く先になる（大数の法則）。和の期待値は期待値の和（線形性）。",
   "formulas": [
    {
     "tex": "E(X)=\\sum_x x\\,p(x)",
     "symbols": [
      {
       "symbol": "E(X)",
       "meaning": "X の期待値（平均の行き着く先）"
      },
      {
       "symbol": "x",
       "meaning": "X がとりうる値"
      },
      {
       "symbol": "p(x)",
       "meaning": "X が x になる確率（重み）",
       "range": "0以上1以下・合計1"
      }
     ]
    },
    {
     "tex": "E(aX+b)=aE(X)+b",
     "label": "線形性",
     "symbols": [
      {
       "symbol": "a, b",
       "meaning": "定数（単位の換算や、一律の上乗せ）"
      }
     ]
    }
   ],
   "conditions": {
    "math": [
     "和（連続なら積分）が有限の値になる"
    ],
    "data": [
     "くり返しの平均として読むには、同じ条件の試行がくり返せること"
    ]
   },
   "example": "さいころの目の期待値は (1＋2＋…＋6)÷6＝3.5。",
   "counterexample": "期待値 3.5 の目は実際には出ない。期待値は「よく出る値」（最頻値）でも「真ん中の値」（中央値）でもない。",
   "misconceptions": [
    {
     "misconception": "期待値は実際に出る値",
     "correction": "何度もくり返したときの平均の行き着く先で、1回の結果としては出ないこともある"
    },
    {
     "misconception": "期待値がいちばん出やすい値",
     "correction": "いちばん出やすい値は最頻値。右に裾が長い分布では、期待値は最頻値より大きくなる"
    }
   ],
   "sources": [
    {
     "title": "公式2級範囲表",
     "locator": "確率モデルの導入（確率変数・確率分布）",
     "url": "https://www.toukei-kentei.jp/hubfs/files/grade_range/grade2_hani_20181214.pdf"
    }
   ]
  },
  {
   "id": "stats2:TERM-indep",
   "name": "独立",
   "status": "filled",
   "version": 1,
   "units": [
    "stats2:U10",
    "stats2:U11",
    "stats2:U13",
    "stats2:U14"
   ],
   "problems": [],
   "en": "independence",
   "definition": "一方が起きたかどうかで、もう一方の起こりやすさが変わらないこと。",
   "principle": "P(A∩B)＝P(A)P(B)。確率変数なら同時の確率が積に分かれる。独立なら共分散は0になり、和の分散は分散の和になる。",
   "formulas": [
    {
     "tex": "P(A\\cap B)=P(A)\\,P(B)",
     "symbols": [
      {
       "symbol": "A, B",
       "meaning": "2つの事象"
      },
      {
       "symbol": "P(A∩B)",
       "meaning": "A と B が両方起きる確率"
      }
     ]
    }
   ],
   "conditions": {
    "math": [
     "確率が決まった2つの事象（または確率変数）について言う"
    ],
    "data": [
     "データで「独立」と言うには、仕組み（別々のさいころ・別々の客）から言えるか、検定などで確かめる。相関が0でも独立とは限らない"
    ]
