{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kn-schema-v1",
  "title": "knowledge-net：教材が書き出す概念・関係・導出のデータ（v1 下書き）",
  "description": "ID は『教材名:教材の中のID』。関係は別の教材の概念も指せる。リポジトリ knowledge-net を作るまでは、このファイルが元（教材の build はこれで検査する）。 関係の種類の定義・矢印の読み方・該当例・該当しない例は relation-types.yaml。",
  "type": "object",
  "required": [
    "schema",
    "version",
    "course",
    "concepts",
    "relations",
    "derivations"
  ],
  "additionalProperties": false,
  "$defs": {
    "gid": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "gids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gid"
      }
    },
    "labs": {
      "type": "array",
      "description": "数理ラボへの参照（概念・関係で共通の形）。ラボの定義（値・学習目標）はラボの側。url は教材の build が作る",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LAB-[A-Za-z0-9-]+$"
          },
          "preset": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tour",
              "check"
            ],
            "description": "tour：ラボで解説（解説付き再生。答えを見せる）／check：ラボで確かめる（予想・法則・自由に動かす）。教材の build が版から判定する（stats2-course #90）"
          }
        }
      }
    },
    "formulaNode": {
      "description": "式の分解の木の節。葉は記号（sym：記号の key）か数（num）。それ以外は演算（op）と引数（args）。記号は formulas[].symbols の key を指し、記号が概念を指せば、木を下にたどって別の概念の式へ開ける（stats2-course #71）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sym"
          ],
          "additionalProperties": false,
          "properties": {
            "sym": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "num"
          ],
          "additionalProperties": false,
          "properties": {
            "num": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "add",
                "sub",
                "mul",
                "div",
                "pow",
                "neg",
                "sqrt",
                "abs",
                "sum",
                "prod",
                "int",
                "fn"
              ],
              "description": "eq：等しい（左辺, 右辺, …）・add・sub・mul・div・pow（底, 指数）・neg・sqrt・abs・sum／prod（var の範囲で足す・掛ける）・int（var で積分）・fn（name の関数。E・V・Cov・P・exp・log・Φ・階乗・組合せ など）"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/formulaNode"
              }
            },
            "name": {
              "type": "string",
              "description": "fn の名前（表示に使う。E・V・Cov・P・exp・log・Φ・fact・comb など）"
            },
            "var": {
              "type": "string",
              "description": "sum・prod・int で動かす記号の key"
            },
            "lower": {
              "$ref": "#/$defs/formulaNode"
            },
            "upper": {
              "$ref": "#/$defs/formulaNode"
            }
          }
        }
      ]
    },
    "figures": {
      "type": "array",
      "description": "図への参照（概念・関係で共通の形）。図は教材の build が設定から作り、公開サイトに置く。url は教材の build が作る（stats2-course #88）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIG-[A-Za-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "experiment": {
      "description": "実験室（stats2-course #102）。model で形が分かれる：binom（二項分布）・table（値の表。#119）",
      "if": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "const": "table"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/experimentTable"
      },
      "else": {
        "$ref": "#/$defs/experimentBinom"
      }
    },
    "experimentBinom": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "question",
        "links",
        "model",
        "vary",
        "start",
        "compare",
        "themes"
      ],
      "additionalProperties": false,
      "description": "実験室（stats2-course #102・計画の 6 の骨格）。実験の定義をデータで書き、画面は読むだけ。予想の答えは書かない（モデルから画面が求める）",
      "properties": {
        "id": {
          "$ref": "#/$defs/gid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text",
          "description": "今回の問い（毎画面の上に出す）"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "description": "つなぐ概念（点）と関係・導出（線）。どちらか1つ以上",
          "minProperties": 1,
          "properties": {
            "concepts": {
              "$ref": "#/$defs/gids"
            },
            "relations": {
              "$ref": "#/$defs/gids"
            }
          }
        },
        "model": {
          "enum": [
            "binom"
          ],
          "description": "理論のモデル：二項分布（binom）"
        },
        "vary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "p"
          ],
          "properties": {
            "n": {
              "type": "object",
              "required": [
                "min",
                "max",
                "step"
              ],
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "p": {
              "type": "object",
              "required": [
                "min",
                "max",
                "step"
              ],
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "p"
          ],
          "description": "予測の段で見せる前の条件",
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "compare": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "問いで変える条件（start からの差分）",
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "steps"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/text"
            },
            "concept": {
              "$ref": "#/$defs/gid"
            },
            "formula": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "$ref": "#/$defs/texts"
            }
          }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "icon",
              "success",
              "failure"
            ],
            "additionalProperties": false,
            "description": "場面（こういう時に使う）。計算は同じで、並びの絵・言葉・最初の p が変わる",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "icon": {
                "$ref": "#/$defs/text"
              },
              "success": {
                "$ref": "#/$defs/text"
              },
              "failure": {
                "$ref": "#/$defs/text"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "story": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "next": {
          "type": "array",
          "description": "応用の段の次の問い",
          "items": {
            "type": "object",
            "required": [
              "question",
              "set"
            ],
            "additionalProperties": false,
            "properties": {
              "question": {
                "$ref": "#/$defs/text"
              },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "points": {
          "$ref": "#/$defs/texts",
          "description": "ⓘ のシートのポイント"
        },
        "counterexamples": {
          "type": "array",
          "description": "反例を実験する：成り立つ条件（breaks）を1つ崩した起き方で、理論とのずれを見る。数は概念しだい（いくつでも）",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "breaks",
              "mechanism",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "mechanism": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "description": "起き方（math-lab の engine の Mechanism）。n・p は条件から入る",
                "properties": {
                  "kind": {
                    "enum": [
                      "urn",
                      "streak",
                      "mix"
                    ]
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "success": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "carry": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "spread": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "concept": {
                "$ref": "#/$defs/gid"
              },
              "breaks": {
                "$ref": "#/$defs/text",
                "description": "崩した成り立つ条件（概念の conditions の言葉で）"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "description": "実験室の入口「何を確かめたい？」に並べる問い（stats2-course #161）。最初の問い（question・start・compare）と反例（counterexamples）に加えて並べる。form は問いの形（予測と観察の部品の組）。予想の答えは書かない",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "form",
              "title",
              "question",
              "set",
              "events"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "form": {
                "enum": [
                  "prob"
                ],
                "description": "問いの形：prob（確率の値：事象の確率を目盛りで予想し、範囲に入ったセットの割合と理論を照らす）"
              },
              "title": {
                "$ref": "#/$defs/text",
                "description": "入口の一覧に出す短い名前"
              },
              "question": {
                "$ref": "#/$defs/text",
                "description": "今回の問い（毎画面の上に出す）"
              },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "n",
                  "p"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "description": "確率を予想する事象（2つなら並べて比べる）",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "k"
                  ],
                  "properties": {
                    "op": {
                      "enum": [
                        "eq",
                        "ge",
                        "le"
                      ],
                      "description": "eq：ちょうど k 回、ge：k 回以上、le：k 回以下"
                    },
                    "k": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "prob_scale": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "確率の値の問いで予想に使う目盛り（大きい順の境目。例 0.5・0.2・0.05・0.01 → 50%以上／20〜50%／…／1%未満）。境目の近くに答えがある問いは教材の build が止める",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    },
    "experimentTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "question",
        "links",
        "model",
        "themes"
      ],
      "description": "値の表の実験室（stats2-course #119）：値と重みの表から1回ずつ引き、平均（期待値）を確かめる。予想の答えは書かない（表から画面が求める）。values と重みの数が同じことは教材の build が確かめる",
      "properties": {
        "id": {
          "$ref": "#/$defs/gid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text",
          "description": "今回の問い（毎画面の上に出す）"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "description": "つなぐ概念（点）と関係・導出（線）。どちらか1つ以上",
          "minProperties": 1,
          "properties": {
            "concepts": {
              "$ref": "#/$defs/gids"
            },
            "relations": {
              "$ref": "#/$defs/gids"
            }
          }
        },
        "model": {
          "const": "table",
          "description": "理論のモデル：値の表（table）"
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "icon",
              "values",
              "start",
              "compare",
              "change"
            ],
            "description": "場面（こういう時に使う）。値の表と、前の重み・問いで変えた重み",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "icon": {
                "$ref": "#/$defs/text"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "story": {
                "$ref": "#/$defs/text"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                },
                "description": "値（賞金・目など）。小さい順"
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                },
                "description": "値の呼び名（なければ値と単位）。values と同じ数"
              },
              "start": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "description": "前の表の重み（合計で割って確率にする）"
              },
              "compare": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "description": "問いで変えた重み"
              },
              "change": {
                "$ref": "#/$defs/text",
                "description": "何を変えたかの文（「6 の面を3倍出やすくする」）"
              }
            }
          }
        },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "steps"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/text"
            },
            "concept": {
              "$ref": "#/$defs/gid"
            },
            "formula": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "$ref": "#/$defs/texts"
            }
          }
        },
        "counterexamples": {
          "type": "array",
          "description": "反例を実験する：成り立つ条件（breaks）を崩した表で、引いた平均がどうなるかを見る。数は概念しだい",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "breaks",
              "values",
              "weights",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "breaks": {
                "$ref": "#/$defs/text",
                "description": "崩した成り立つ条件（概念の conditions の言葉で）"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "weights": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                },
                "description": "値の呼び名（なければ値と単位）。values と同じ数"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "concept": {
                "$ref": "#/$defs/gid"
              }
            }
          }
        },
        "points": {
          "$ref": "#/$defs/texts",
          "description": "ⓘ のシートのポイント"
        },
        "contrasts": {
          "type": "array",
          "description": "誤解を正す例・指標の限界を示す比較（成り立つ条件を外す実験は counterexamples）。stats2-course #118 の反例の方針：確かめる主張（claim）を先に書き、比べる表をそろえる",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "claim",
              "tables",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "misconception",
                  "limit"
                ],
                "description": "misconception：誤解を正す例、limit：指標の限界を示す比較"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "claim": {
                "$ref": "#/$defs/text",
                "description": "確かめる主張（例：平均は同じでも散らばりが違う）"
              },
              "tables": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/valueTable"
                },
                "description": "見る表（比べるときは2つ。比べる条件をそろえる）"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "concept": {
                "$ref": "#/$defs/gid",
                "description": "観察のあとに考える概念（例：分散）"
