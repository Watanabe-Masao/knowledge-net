{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watanabe-masao.github.io/knowledge-net/schema/kn-schema-v1.json",
  "title": "knowledge-net：教材が書き出す概念・関係・導出のデータ（v1 下書き）",
  "description": "ID は『教材名:教材の中のID』。関係は別の教材の概念も指せる。リポジトリ knowledge-net を作るまでは、このファイルが元（教材の build はこれで検査する）。 関係の種類の定義・矢印の読み方・該当例・該当しない例は relation-types.yaml。",
  "type": "object",
  "required": [
    "schema",
    "version",
    "course",
    "concepts",
    "relations",
    "derivations"
  ],
  "additionalProperties": false,
  "$defs": {
    "gid": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "gids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gid"
      }
    },
    "labs": {
      "type": "array",
      "description": "数理ラボへの参照（概念・関係で共通の形）。ラボの定義（値・学習目標）はラボの側。url は教材の build が作る",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LAB-[A-Za-z0-9-]+$"
          },
          "preset": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tour",
              "check"
            ],
            "description": "tour：ラボで解説（解説付き再生。答えを見せる）／check：ラボで確かめる（予想・法則・自由に動かす）。教材の build が版から判定する（stats2-course #90）"
          },
          "play": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "description": "ネットワークの画面がこの版を JS の部品で描くための形（stats2-course #188 04b・#192）。教材の build がラボの版（tool.yaml）から作る。予想の答えは入れない",
            "properties": {
              "mode": {
                "type": "string"
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "set": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    }
                  ]
                }
              },
              "task": {
                "$ref": "#/$defs/text"
              },
              "kmax": {
                "type": "integer",
                "minimum": 1
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "text",
                    "states"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": [
                                "number",
                                "string"
                              ]
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": [
                                  "number",
                                  "string"
                                ]
                              }
                            }
                          ]
                        }
                      }
                    },
                    "focus": {
                      "type": "string"
                    },
                    "gist": {
                      "type": "boolean"
                    },
                    "ms": {
                      "type": "integer",
                      "minimum": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "formulaNode": {
      "description": "式の分解の木の節。葉は記号（sym：記号の key）か数（num）。それ以外は演算（op）と引数（args）。記号は formulas[].symbols の key を指し、記号が概念を指せば、木を下にたどって別の概念の式へ開ける（stats2-course #71）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sym"
          ],
          "additionalProperties": false,
          "properties": {
            "sym": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "num"
          ],
          "additionalProperties": false,
          "properties": {
            "num": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "add",
                "sub",
                "mul",
                "div",
                "pow",
                "neg",
                "sqrt",
                "abs",
                "sum",
                "prod",
                "int",
                "fn"
              ],
              "description": "eq：等しい（左辺, 右辺, …）・add・sub・mul・div・pow（底, 指数）・neg・sqrt・abs・sum／prod（var の範囲で足す・掛ける）・int（var で積分）・fn（name の関数。E・V・Cov・P・exp・log・Φ・階乗・組合せ など）"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/formulaNode"
              }
            },
            "name": {
              "type": "string",
              "description": "fn の名前（表示に使う。E・V・Cov・P・exp・log・Φ・fact・comb など）"
            },
            "var": {
              "type": "string",
              "description": "sum・prod・int で動かす記号の key"
            },
            "lower": {
              "$ref": "#/$defs/formulaNode"
            },
            "upper": {
              "$ref": "#/$defs/formulaNode"
            }
          }
        }
      ]
    },
    "figures": {
      "type": "array",
      "description": "図への参照（概念・関係で共通の形）。図は教材の build が設定から作り、公開サイトに置く。url は教材の build が作る（stats2-course #88）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIG-[A-Za-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "valueTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "values",
        "weights"
      ],
      "description": "値の表：値（小さい順）と重み（0以上。合計で割って確率にする）",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "icon": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "値の呼び名（なければ値と単位）。values と同じ数"
        }
      }
    },
    "chartDist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "label"
      ],
      "properties": {
        "model": {
          "enum": [
            "binom",
            "hyper",
            "poisson"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "success": {
          "type": "integer",
          "minimum": 0
        },
        "lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "label": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "binom"
              }
            }
          },
          "then": {
            "required": [
              "n",
              "p"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "hyper"
              }
            }
          },
          "then": {
            "required": [
              "n",
              "total",
              "success"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "model": {
                "const": "poisson"
              }
            }
          },
          "then": {
            "required": [
              "lambda"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "kn-schema"
    },
    "version": {
      "const": 1
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "title",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "number",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/gid"
              },
              "number": {
                "$ref": "#/$defs/text"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "group": {
                "$ref": "#/$defs/text",
                "description": "単元のまとまり（学習・問題集のタブで分ける。stats2-course #42）"
              },
              "problems": {
                "type": "array",
                "description": "単元の問題（問題集のタブの一覧。解いた記録は持たない）",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "stage",
                    "prompt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/gid"
                    },
                    "stage": {
                      "$ref": "#/$defs/text"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              }
            }
          }
        },
        "pillars": {
          "type": "array",
          "description": "柱（分類の大きなまとまり。例：データを記述する → 確率で考える → 推測する）。上から学ぶ順。入口のライブラリと島の地図に使い、色は画面が順に柱の色（--band-1・--band-2…）を当てる（stats2-course #220）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "categories"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "この柱の分類（概念の category の名前）。どの分類もちょうど1つの柱に入る（教材の build が確かめる）"
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "description": "意味のまとまり（分類の中の小さなまとまり。例：確率分布の「くり返して数える」）。並べた順が学ぶ順。分類のページで、まとまりごとに区切って語を並べる（stats2-course #228）。まとまりのない分類は区切らない",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "name"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/gid",
                "description": "教材をまたいで一意（例：stats2:GRP-dist-count）"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "このまとまりが入る分類（概念の category の名前）"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "summary": {
                "$ref": "#/$defs/text",
                "description": "まとまりを1文で（何を学ぶまとまりか）"
              }
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "units",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/gid"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "en": {
            "type": "string"
          },
          "status": {
            "enum": [
              "filled",
              "skeleton",
              "stub"
            ],
            "description": "filled：説明あり。skeleton：骨格（定義1文と分類だけ。肉付けは段階ごとに）。stub：関係から指されているが、骨格もまだない概念"
          },
          "definition": {
            "$ref": "#/$defs/text"
          },
          "principle": {
            "$ref": "#/$defs/text"
          },
          "conditions": {
            "type": "object",
            "required": [
              "math"
            ],
            "additionalProperties": false,
            "description": "math：数学的な定義・成立の条件。data：現実のデータに当てはめるときの条件・確かめ方の手掛かり",
            "properties": {
              "math": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "data": {
                "$ref": "#/$defs/texts"
              }
            }
          },
          "example": {
            "$ref": "#/$defs/text"
          },
          "counterexample": {
            "$ref": "#/$defs/text"
          },
          "units": {
            "$ref": "#/$defs/gids"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formulas": {
            "type": "array",
            "description": "式ごとに記号の意味を持つ",
            "items": {
              "type": "object",
              "required": [
                "tex"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^F-[a-z0-9]+(-[a-z0-9]+)*$",
                  "description": "式の ID（教材の中で変えない・消さない。要らなくなった式は残す）。#118 D1"
                },
                "defined_in": {
                  "type": "string",
                  "description": "この式の元がある概念の id（同じ式を2つの概念に出すとき、元でない側に書く。式の ID は元と同じ）。#118 D2"
                },
                "tex": {
                  "$ref": "#/$defs/text"
                },
                "label": {
                  "type": "string"
                },
                "symbols": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "symbol",
                      "meaning"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "symbol": {
                        "$ref": "#/$defs/text"
                      },
                      "meaning": {
                        "$ref": "#/$defs/text"
                      },
                      "range": {
                        "type": "string"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "木の葉（sym）から指す名前"
                      },
                      "concept": {
                        "$ref": "#/$defs/gid",
                        "description": "この記号が表す概念（教材名:ID）。木をたどって、その概念の式へ開く"
                      },
                      "kind": {
                        "enum": [
                          "value",
                          "data",
                          "rv",
                          "param",
                          "index",
                          "const"
                        ],
                        "description": "value：1つの値・data：データの一覧・rv：確率変数・param：母数・index：添え字・const：定数"
                      },
                      "of": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "どの確率変数の記号か（同じ式の確率変数の key。μ は X の期待値なら X）。関数を開いて引数を結び付けるとき、この記号も一緒に移す（stats2-course #109）"
                      },
                      "domain": {
                        "type": "object",
                        "additionalProperties": false,
                        "description": "定義域（値を入れて計算するときの範囲。range は文の説明）。min・max は数か同じ式の記号の key（k ≦ n）、端を含むか（既定は含む）、整数か、0でないか（stats2-course #109）",
                        "properties": {
                          "min": {
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                              }
                            ],
                            "description": "数か、同じ式の記号の key（k ≦ n なら max: n）"
                          },
                          "max": {
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                              }
                            ],
                            "description": "数か、同じ式の記号の key（k ≦ n なら max: n）"
                          },
                          "minOpen": {
                            "type": "boolean",
                            "description": "true なら min を含まない"
                          },
                          "maxOpen": {
                            "type": "boolean",
                            "description": "true なら max を含まない"
                          },
                          "integer": {
                            "type": "boolean"
                          },
                          "nonzero": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                },
                "tree": {
                  "$ref": "#/$defs/formulaNode",
                  "description": "式の分解の木（任意）。あれば tex はここから作れる"
                },
                "parts": {
                  "type": "array",
                  "description": "式の意味のかたまり（作業台で押せる部分式。stats2-course #110）。path は木の根からの args の番号（右辺の2つ目の因子なら [1, 1]）",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "name",
                      "meaning"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "name": {
                        "$ref": "#/$defs/text"
                      },
                      "meaning": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                },
                "conditions": {
                  "type": "array",
                  "description": "記号どうしの条件（1つの記号の domain で書けないもの：超幾何の k ≦ M など）。tree は比べる式（le・lt・ge・gt・between）。画面は値がこれを満たさないとき計算せず text を出す。#118",
                  "items": {
                    "type": "object",
                    "required": [
                      "text",
                      "tree"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "tree": {
                        "$ref": "#/$defs/formulaNode"
                      }
                    }
                  }
                },
                "unverified": {
                  "type": "boolean",
                  "description": "独立な見本でまだ値を確かめていない式（true のときだけ書く）。画面は「未検証」の印を出す。#118 D4"
                },
                "review_pending": {
                  "type": "boolean",
                  "description": "数で保証できない観点の個別レビューが済んでいない式（true のときだけ書く）。画面は「レビュー前」の印を出す。#118 D4"
                },
                "why": {
                  "type": "object",
                  "description": "この式でなぜその値（確率など）が求まるかの段（作業台の読み方「構造」で順に出す。stats2-course #188）。steps の parts は、その段で効く式の部品（parts の番号）。note は前提が崩れたときに、どの段が成り立たなくなるか",
                  "required": [
                    "steps"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "steps": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "required": [
                          "title",
                          "text"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "$ref": "#/$defs/text"
                          },
                          "text": {
                            "$ref": "#/$defs/text"
                          },
