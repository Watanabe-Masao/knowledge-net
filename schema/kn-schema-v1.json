{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kn-schema-v1",
  "title": "knowledge-net：教材が書き出す概念・関係・導出のデータ（v1 下書き）",
  "description": "ID は『教材名:教材の中のID』。関係は別の教材の概念も指せる。リポジトリ knowledge-net を作るまでは、このファイルが元（教材の build はこれで検査する）。 関係の種類の定義・矢印の読み方・該当例・該当しない例は relation-types.yaml。",
  "type": "object",
  "required": [
    "schema",
    "version",
    "course",
    "concepts",
    "relations",
    "derivations"
  ],
  "additionalProperties": false,
  "$defs": {
    "gid": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "gids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gid"
      }
    },
    "labs": {
      "type": "array",
      "description": "数理ラボへの参照（概念・関係で共通の形）。ラボの定義（値・学習目標）はラボの側。url は教材の build が作る",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LAB-[A-Za-z0-9-]+$"
          },
          "preset": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tour",
              "check"
            ],
            "description": "tour：ラボで解説（解説付き再生。答えを見せる）／check：ラボで確かめる（予想・法則・自由に動かす）。教材の build が版から判定する（stats2-course #90）"
          }
        }
      }
    },
    "formulaNode": {
      "description": "式の分解の木の節。葉は記号（sym：記号の key）か数（num）。それ以外は演算（op）と引数（args）。記号は formulas[].symbols の key を指し、記号が概念を指せば、木を下にたどって別の概念の式へ開ける（stats2-course #71）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sym"
          ],
          "additionalProperties": false,
          "properties": {
            "sym": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "num"
          ],
          "additionalProperties": false,
          "properties": {
            "num": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "add",
                "sub",
                "mul",
                "div",
                "pow",
                "neg",
                "sqrt",
                "abs",
                "sum",
                "prod",
                "int",
                "fn"
              ],
              "description": "eq：等しい（左辺, 右辺, …）・add・sub・mul・div・pow（底, 指数）・neg・sqrt・abs・sum／prod（var の範囲で足す・掛ける）・int（var で積分）・fn（name の関数。E・V・Cov・P・exp・log・Φ・階乗・組合せ など）"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/formulaNode"
              }
            },
            "name": {
              "type": "string",
              "description": "fn の名前（表示に使う。E・V・Cov・P・exp・log・Φ・fact・comb など）"
            },
            "var": {
              "type": "string",
              "description": "sum・prod・int で動かす記号の key"
            },
            "lower": {
              "$ref": "#/$defs/formulaNode"
            },
            "upper": {
              "$ref": "#/$defs/formulaNode"
            }
          }
        }
      ]
    },
    "figures": {
      "type": "array",
      "description": "図への参照（概念・関係で共通の形）。図は教材の build が設定から作り、公開サイトに置く。url は教材の build が作る（stats2-course #88）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIG-[A-Za-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "kn-schema"
    },
    "version": {
      "const": 1
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "title",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "number",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/gid"
              },
              "number": {
                "$ref": "#/$defs/text"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "units",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/gid"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "en": {
            "type": "string"
          },
          "status": {
            "enum": [
              "filled",
              "stub"
            ],
            "description": "stub：関係から指されているが、説明がまだない概念"
          },
          "definition": {
            "$ref": "#/$defs/text"
          },
          "principle": {
            "$ref": "#/$defs/text"
          },
          "conditions": {
            "type": "object",
            "required": [
              "math"
            ],
            "additionalProperties": false,
            "description": "math：数学的な定義・成立の条件。data：現実のデータに当てはめるときの条件・確かめ方の手掛かり",
            "properties": {
              "math": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "data": {
                "$ref": "#/$defs/texts"
              }
            }
          },
          "example": {
            "$ref": "#/$defs/text"
          },
          "counterexample": {
            "$ref": "#/$defs/text"
          },
          "units": {
            "$ref": "#/$defs/gids"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formulas": {
            "type": "array",
            "description": "式ごとに記号の意味を持つ",
            "items": {
              "type": "object",
              "required": [
                "tex"
              ],
              "additionalProperties": false,
              "properties": {
                "tex": {
                  "$ref": "#/$defs/text"
                },
                "label": {
                  "type": "string"
                },
                "symbols": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "symbol",
                      "meaning"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "symbol": {
                        "$ref": "#/$defs/text"
                      },
                      "meaning": {
                        "$ref": "#/$defs/text"
                      },
                      "range": {
                        "type": "string"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "木の葉（sym）から指す名前"
                      },
                      "concept": {
                        "$ref": "#/$defs/gid",
                        "description": "この記号が表す概念（教材名:ID）。木をたどって、その概念の式へ開く"
                      },
                      "kind": {
                        "enum": [
                          "value",
                          "data",
                          "rv",
                          "param",
                          "index",
                          "const"
                        ],
                        "description": "value：1つの値・data：データの一覧・rv：確率変数・param：母数・index：添え字・const：定数"
                      }
                    }
                  }
                },
                "tree": {
                  "$ref": "#/$defs/formulaNode",
                  "description": "式の分解の木（任意）。あれば tex はここから作れる"
                }
              }
            }
          },
          "misconceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "misconception",
                "correction"
              ],
              "additionalProperties": false,
              "properties": {
                "misconception": {
                  "$ref": "#/$defs/text"
                },
                "correction": {
                  "$ref": "#/$defs/text"
                },
                "labs": {
                  "$ref": "#/$defs/labs",
                  "description": "この誤解を崩すラボの場面"
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "$ref": "#/$defs/text"
                },
                "locator": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "説明を書き直して意味が変わったら1つ上げる。個人の記録はどの版で学んだかを指す"
          },
          "labs": {
            "$ref": "#/$defs/labs"
          },
          "counterexample_labs": {
            "$ref": "#/$defs/labs",
            "description": "反例を数で確かめるラボの場面"
          },
          "figures": {
            "$ref": "#/$defs/figures"
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "filled"
            }
          }
        },
        "then": {
          "required": [
            "definition",
            "principle",
            "conditions",
            "example",
            "counterexample"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type",
          "description",
          "units",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/gid"
          },
          "from": {
            "$ref": "#/$defs/gid"
          },
          "to": {
            "$ref": "#/$defs/gid"
          },
          "type": {
            "enum": [
              "前提",
              "導出",
              "一般化",
              "特殊化",
              "変換",
              "対比",
              "統合",
              "応用"
            ]
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "conditions": {
            "$ref": "#/$defs/texts"
          },
          "derivation": {
            "$ref": "#/$defs/gid"
          },
          "units": {
            "$ref": "#/$defs/gids"
          },
          "mode": {
            "enum": [
              "exact",
              "approximation",
              "limit"
            ],
            "description": "変換のとき必須。厳密・近似・極限"
          },
          "premise": {
            "enum": [
              "learning",
              "mathematical"
            ],
            "description": "前提のとき必須。理解に必要な知識／数学的な成立条件"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "説明を書き直して意味が変わったら1つ上げる。個人の記録はどの版で学んだかを指す"
          },
          "labs": {
            "$ref": "#/$defs/labs"
          },
          "figures": {
            "$ref": "#/$defs/figures"
          },
          "gist": {
            "type": "string",
            "description": "つまり：その関係が言っていることを日常の言葉で1〜2文。説明・図・ラボより先に出す（stats2-course #95）"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "変換"
                }
              }
            },
            "then": {
              "required": [
                "mode",
                "conditions"
              ],
              "properties": {
                "conditions": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "導出"
                }
              }
            },
            "then": {
              "required": [
                "conditions"
              ],
              "properties": {
                "conditions": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "前提"
                }
              }
            },
            "then": {
              "required": [
                "premise"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "not": {
                    "const": "変換"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "mode"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "not": {
                    "const": "前提"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "premise"
                ]
              }
            }
          }
        ]
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "premises",
          "conclusion",
          "statement",
          "steps",
          "conditions",
          "units",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/gid"
          },
          "premises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/gid"
            }
          },
          "conclusion": {
            "$ref": "#/$defs/gid"
          },
          "statement": {
            "$ref": "#/$defs/text"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "units": {
            "$ref": "#/$defs/gids"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "説明を書き直して意味が変わったら1つ上げる。個人の記録はどの版で学んだかを指す"
          }
        }
      }
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "書き出した教材が使った型の改訂番号（x-revision）"
    }
  },
  "$comment": "改訂 2（2026-10-29）：概念・関係に任意の labs を追加。変更履歴は schema/CHANGELOG.md",
  "x-revision": 6
}
