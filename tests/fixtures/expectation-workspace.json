  "conditions": {
    "math": [
      "値の大きさ×確率の和（連続なら積分）が有限の値になる（絶対収束：足す順序で値が変わらない）"
    ],
    "data": [
      "くり返しの平均として読むには、同じ条件の試行がくり返せること"
    ]
  },
  "example": "さいころの目の期待値は (1＋2＋…＋6)÷6＝3.5。",
  "counterexample": "期待値 3.5 の目は実際には出ない。期待値は「よく出る値」（最頻値）でも「真ん中の値」（中央値）でもない。",
  "misconceptions": [
    {
      "misconception": "期待値は実際に出る値",
      "correction": "何度もくり返したときの平均の行き着く先で、1回の結果としては出ないこともある"
    },
    {
      "misconception": "期待値がいちばん出やすい値",
      "correction": "いちばん出やすい値は最頻値。右に裾が長い分布では、期待値は最頻値より大きくなる"
    }
  ],
