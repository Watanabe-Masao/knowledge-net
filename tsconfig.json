{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@math-lab/ui": [
        "./vendor/math-lab/packages/ui/src/index.ts"
      ],
      "@math-lab/engine": [
        "./vendor/math-lab/packages/engine/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
